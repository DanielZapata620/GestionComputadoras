<UserControl x:Class="Servidor.Views.CompuHistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Servidor.Views"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="800" FontSize="18" 
             >

    <Border BorderBrush="WhiteSmoke" BorderThickness="1"
            Height="80px">
        
   
        <Grid >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="60"
                   Height="60"
                   Margin="15,0,15,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Source="/Images/pcIcon.png"
                   >
                <Image.Effect>
                    <DropShadowEffect Color="White"
                      BlurRadius="1"
                      ShadowDepth=".5"
                      Opacity="1"/>
                </Image.Effect>
            </Image>
          

            
            <TextBlock Grid.Column="1"
                       Text="{Binding Identificador}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>

            
            <TextBlock Grid.Column="2"
                       Text="{Binding NumLaboratorio}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>

          
            <TextBlock Grid.Column="3"
                       Text="{Binding NumPc}"
                       Foreground="White"
                       VerticalAlignment="Center"
                        TextAlignment="Center"/>

            
            <TextBlock Grid.Column="4"
                       Text="{Binding FechaRegistro}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>

          
            <TextBlock Grid.Column="5"
                       Text="{Binding UltimaVez}"
                       Foreground="White"
                       VerticalAlignment="Center"
                        TextAlignment="Center"/>

        </Grid>

    </Border>
</UserControl>
