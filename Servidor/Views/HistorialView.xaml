<UserControl x:Class="Servidor.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:views="clr-namespace:Servidor.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Servidor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  Background="#1E1B1B">
    <Grid>

        
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#5C4F4F" Grid.Row="0">
            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

               
                <TextBlock Text="HISTORIAL"
                           FontSize="28"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                
                <Button Grid.Column="1"
                        Height="40"
                        Width="130"
                        Background="#2E2525"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="PANEL DE CONTROL"
                        FontWeight="Bold"
                        Command="{Binding CambiarVistaCommand}"
                        CommandParameter="Panel" >

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>

                  

                </Button>

            </Grid>
        </Border>

        
        
        
        <Grid Grid.Row="1" Margin="40,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="En este historial solo se muestran las computadoras que ya no se volvieron a conectar pero que fueron registradas en algún momento."
                       Foreground="White"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding ListaComputadoras}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CompuHistorialView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>
