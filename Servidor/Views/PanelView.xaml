<UserControl x:Class="Servidor.Views.PanelView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:views="clr-namespace:Servidor.Views"
      xmlns:local="clr-namespace:Servidor.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
        Background="#1E1B1B" FontFamily="Segoe UI" >

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <Border Background="#5C4F4F"
                Grid.Row="0">

            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="PANEL DE CONTROL" 
                           FontSize="28"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                
                <Button Grid.Column="1"
                        Height="40"
                        Width="130"
                        Background="#2E2525"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand" Command="{Binding CambiarVistaCommand}"
        CommandParameter="Historial">

                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock Text="📋"
                                   FontSize="16"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="HISTORIAL"
                                   FontSize="13"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>


   
        <Grid Grid.Row="1"
              Margin="40,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>

                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                   
                </Grid.ColumnDefinitions>

                
                    <!--<ComboBox Background="#6A5C5C"
                      ItemsSource="{Binding ListaLaboratorios}" 
SelectedItem="{Binding LabSeleccionado, Mode=TwoWay}" 
                      Foreground="Black"
                      BorderThickness="0"
                      Height="30"
                      VerticalAlignment="Center">
                       


                    </ComboBox>-->

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              Grid.Column="0"
              Grid.ColumnSpan="2">

                    <ItemsControl ItemsSource="{Binding ListaLaboratorios}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button Content="{Binding .}" 
                        Margin="5,0"
                        Padding="15,5"
                        Background="#6A5C5C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DataContext.FiltrarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">

                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>

                                </Button>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>




                <Button Grid.Column="2"
                        Background="#6A5C5C"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="10,0"
                        Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock Text="⟳ REFRESCAR"
                                   FontSize="14"
                                   Margin="0,0,6,0">
                           
                        </TextBlock>
                      

                    </StackPanel>

                </Button>

               

            </Grid>


           
            <ScrollViewer Grid.Row="1" 
              VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding ListaComputadoras}">

                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ComputadoraView Margin="10"></views:ComputadoraView>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>
