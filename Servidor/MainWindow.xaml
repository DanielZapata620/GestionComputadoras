<Window x:Class="Servidor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Servidor.Viewmodels"
        xmlns:local="clr-namespace:Servidor"
        x:Name="ventana"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:ServidorViewmodel></vm:ServidorViewmodel>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR CON BOTONES -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <Button Content="🔍 Descubrir computadoras"
                    
                    Margin="5"
                    Padding="15,8"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="Bold"
                       />

                <Button Content="🌐 Verificar conexión de internet"
                   
                    Margin="5"
                    Padding="15,8"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"/>

            </StackPanel>
        </Border>

        <!-- LISTA DE COMPUTADORAS -->
        <ListView Grid.Row="1" Margin="10" ItemsSource="{Binding ListaComputadoras}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Identificador -->
                            <StackPanel>
                                <TextBlock Text="Identificador:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Identificador}" FontSize="14"/>
                            </StackPanel>

                            <!-- Estatus -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Estatus:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Encendida}"/>
                            </StackPanel>

                            <!-- Internet -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Internet:" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Conexion}"/>
                            </StackPanel>

                            <!-- Botón Apagar -->
                            <Button Grid.Column="3"
                                Content="Apagar"
                                Padding="10,5"
                                Margin="10,0,0,0"
                                Background="#E74C3C"
                                Foreground="White"
                                                      Command="{Binding DataContext.ApagarCommand, Source={x:Reference ventana}}"
CommandParameter="{Binding Identificador}" />

                            <Button Grid.Column="4"
                             Content="CONDXION"
                             Padding="10,5"
                             Margin="10,0,0,0"
                             Background="#E74C3C"
                             Foreground="White"
                              Command="{Binding DataContext.VerificarInternetCommand, Source={x:Reference ventana}}"
        CommandParameter="{Binding Identificador}" />  
                     </Grid>

                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
