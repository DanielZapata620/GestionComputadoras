<UserControl x:Class="Cliente.Views.ApagarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cliente.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="LA COMPUTADORA SE APAGARA EN" FontSize="28" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Contador}" 
               FontSize="40" 
               FontWeight="Bold" 
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0 10"/>

        <Button Content="Cancelar apagado" Background="DarkRed" Foreground="White" FontSize="20"  FontWeight="Bold"
            Command="{Binding CancelarApagadoCommand}"
            Width="250" Height="50"/>
    </StackPanel>
</UserControl>
